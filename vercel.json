{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && mkdir -p public && cp DCUGen.html public/index.html && cp web/* public/",
  "outputDirectory": "public",
  "installCommand": "echo no dependencies",
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
