{
  "name": "dcugen-desktop",
  "productName": "DCUGen Hero Forge",
  "version": "6.1.0",
  "description": "DCUGen Hero Forge as a desktop app: your data in a folder on disk, and a lobby for your table.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node -e \"require('fs').copyFileSync('../DCUGen.html','DCUGen.html')\"",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:mac": "npm run prepare-app && electron-builder --mac",
    "dist:linux": "npm run prepare-app && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dcugen.heroforge",
    "productName": "DCUGen Hero Forge",
    "files": ["main.js", "preload.cjs", "lobby-server.js", "DCUGen.html", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"], "category": "Game" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
